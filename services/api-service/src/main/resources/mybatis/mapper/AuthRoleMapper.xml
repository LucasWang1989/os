<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="nz.ac.sit.os.infrastructure.mybatis.mapper.AuthRoleMapper">
    <resultMap id="AuthRoleMap" type="nz.ac.sit.os.domain.auth.Role">
        <id column="F_ID" property="id"/>
        <result column="F_ROLE_NAME" property="roleName"/>
        <result column="DESCRIPTION" property="description"/>
    </resultMap>

    <sql id="Base_Column_List">
        F_ID, F_ROLE_NAME, DESCRIPTION
    </sql>

    <select id="findRolesByUserId" parameterType="Long" resultMap="AuthRoleMap">
        select <include refid="Base_Column_List"/>
        from os_auth_role r, os_auth_user_role ur
        where r.F_ID = ur.F_ROLE_ID
            and ur.F_USER_ID = #{userId}
    </select>

</mapper>